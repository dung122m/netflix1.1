# ==========================================
# CẤU HÌNH API NANAFLIX
# ==========================================
NEXT_PUBLIC_API_URL=https://vsmov.com/api
NEXT_PUBLIC_API_URL_2=https://phimapi.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ==========================================
# CẤU HÌNH FIREBASE (ĐĂNG NHẬP GOOGLE & ĐỒNG BỘ ĐÁM MÂY)
# Lấy miễn phí tại: https://console.firebase.google.com
# Tạo Project -> Project settings -> General -> Your apps -> Web app (</>)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
