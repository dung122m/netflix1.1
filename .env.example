# ==========================================
# CẤU HÌNH API NANAFLIX
# ==========================================
NEXT_PUBLIC_API_URL=https://phim.nguonc.com/api
NEXT_PUBLIC_API_URL_2=https://phimapi.com
TMDB_API_KEY=YOUR_TMDB_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY_FREE_14400_RPD
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# Token riêng cho KV (Tùy chọn: nếu để trống sẽ dùng CLOUDFLARE_API_TOKEN)
CLOUDFLARE_KV_API_TOKEN=YOUR_CLOUDFLARE_KV_API_TOKEN
# Namespace ID của Cloudflare KV
CLOUDFLARE_KV_NAMESPACE_ID=YOUR_CLOUDFLARE_KV_NAMESPACE_ID

# ==========================================
# CẤU HÌNH FIREBASE (ĐĂNG NHẬP GOOGLE & ĐỒNG BỘ ĐÁM MÂY)
# Lấy miễn phí tại: https://console.firebase.google.com
# Tạo Project -> Project settings -> General -> Your apps -> Web app (</>)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
