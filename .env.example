# ==========================================
# CẤU HÌNH API NANAFLIX
# ==========================================
NEXT_PUBLIC_API_URL=https://phim.nguonc.com/api
NEXT_PUBLIC_API_URL_2=https://phimapi.com
TMDB_API_KEY=YOUR_TMDB_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY_FREE_14400_RPD
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
# ==========================================
# CẤU HÌNH UPSTASH REDIS (CACHE TẬP TRUNG SEVERLESS)
# Tạo database Redis miễn phí tại: https://console.upstash.com
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ==========================================
# CẤU HÌNH CLOUDFLARE WORKERS AI (VECTOR EMBEDDINGS & LLM)
# ==========================================
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# Cloudflare KV (Legacy - đang giữ lại để backup trong quá trình verify migration)
CLOUDFLARE_KV_API_TOKEN=YOUR_CLOUDFLARE_KV_API_TOKEN
CLOUDFLARE_KV_NAMESPACE_ID=YOUR_CLOUDFLARE_KV_NAMESPACE_ID

# ==========================================
# CẤU HÌNH FIREBASE (ĐĂNG NHẬP GOOGLE & ĐỒNG BỘ ĐÁM MÂY)
# Lấy miễn phí tại: https://console.firebase.google.com
# Tạo Project -> Project settings -> General -> Your apps -> Web app (</>)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ==========================================
# CẤU HÌNH SUPABASE DATABASE & AUTH
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# CẤU HÌNH ADMIN API AUTHENTICATION
# ==========================================
ADMIN_SYNC_SECRET=your-admin-sync-secret

# ==========================================
# ENVIRONMENT ISOLATION CHO KIỂM THỬ TỰ ĐỘNG (SECURITY INTEGRATION TESTS)
# BẮT BUỘC để chạy các bài test ghi dữ liệu Supabase/Redis.
# Tuyệt đối không trỏ vào database Production của dự án.
# ==========================================
TEST_SUPABASE_URL=https://your-isolated-test-project.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
TEST_REDIS_URL=https://your-test-redis.upstash.io
TEST_REDIS_TOKEN=your-test-redis-token

# ==========================================
# CẤU HÌNH ORIGIN PROTECTION (CHỐNG BYPASS CLOUDFLARE)
# Sử dụng kết hợp Cloudflare Transform Rules (Modify Request Header)
# để bảo vệ Vercel origin không bị gọi trực tiếp qua *.vercel.app.
# ==========================================
# Khóa bí mật chia sẻ giữa Cloudflare Transform Rule và Vercel Edge Middleware
EDGE_ORIGIN_SECRET=your-edge-origin-secret-minimum-32-chars
# Custom domain chính thức của dự án (ví dụ: nanaflix.tv hoặc nanaflix.com)
CUSTOM_DOMAIN=nanaflix.tv

