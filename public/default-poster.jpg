<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 900" width="600" height="900">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18181b"/>
      <stop offset="50%" stop-color="#09090b"/>
      <stop offset="100%" stop-color="#000000"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#e50914" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff1e27"/>
      <stop offset="100%" stop-color="#b81d24"/>
    </linearGradient>
  </defs>
  
  <rect width="600" height="900" fill="url(#bg)"/>
  <rect width="600" height="900" fill="url(#glow)"/>
  
  <!-- Subtle Grid/Cinema Lines -->
  <line x1="60" y1="120" x2="540" y2="120" stroke="rgba(255,255,255,0.06)" stroke-width="1.5"/>
  <line x1="60" y1="780" x2="540" y2="780" stroke="rgba(255,255,255,0.06)" stroke-width="1.5"/>
  
  <!-- Center Film / Play Icon -->
  <g transform="translate(300, 410)">
    <circle cx="0" cy="0" r="58" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
    <polygon points="-12,-20 22,0 -12,20" fill="url(#redGrad)"/>
  </g>
  
  <!-- Brand Logo & Text -->
  <g transform="translate(300, 520)" text-anchor="middle">
    <text y="0" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="900" font-size="28" fill="#ffffff" letter-spacing="4">NANAFLIX</text>
    <text y="28" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="600" font-size="13" fill="rgba(255,255,255,0.4)" letter-spacing="2">CINEMA ENTERTAINMENT</text>
  </g>
</svg>