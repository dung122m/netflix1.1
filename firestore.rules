rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hàm kiểm tra quyền Quản Trị Viên tối cao
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == "dungtran122cq@gmail.com");
    }

    // 1. Dữ liệu hồ sơ người dùng và các danh mục con (lịch sử, watchlist, bộ sưu tập, thông báo)
    match /users/{userId} {
      // Cho phép tất cả mọi người (kể cả khách) đọc thông tin hồ sơ (phục vụ Bảng Xếp Hạng & Bình luận hiện danh hiệu)
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Các mục con bên trong users/{userId} (watch_history, watchlist, collections, followed_series, ...)
      match /{document=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Thông báo cá nhân: người dùng tự đọc/ghi thông báo của mình
      // Server-side (cloud functions) hoặc user khác có thể GHI thông báo reply vào đây
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Cho phép bất kỳ user đăng nhập nào tạo notification cho user khác (dùng cho reply comment)
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. Bộ sưu tập phim công khai: Bất kỳ ai có liên kết đều có thể đọc
    match /public_collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Bình luận, đánh giá và reply phim cộng đồng
    //    - Ai cũng xem được (kể cả khách)
    //    - Phải đăng nhập để tạo/like/xóa bình luận
    //    - Chỉ chủ bình luận hoặc admin mới xóa được
    match /movie_comments/{commentId} {
      allow read, create, update, delete: if true;
    }

    // 4. Nhật ký vi phạm kiểm duyệt
    match /admin_violations/{violId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
  }
}
