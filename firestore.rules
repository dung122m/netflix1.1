rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Quyền truy cập dữ liệu cá nhân của người dùng (watchlist, lịch sử, phiên đồng bộ, bộ sưu tập cá nhân)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Bộ sưu tập phim công khai: Bất kỳ ai có liên kết đều có thể đọc
    match /public_collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Bình luận và đánh giá phim cộng đồng (Ai cũng xem được, đăng nhập để bình luận/like/xóa)
    match /movie_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
