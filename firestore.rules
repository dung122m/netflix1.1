rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hàm kiểm tra quyền Quản Trị Viên tối cao
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == "dungtran122cq@gmail.com");
    }

    // 1. Dữ liệu hồ sơ người dùng và các danh mục con (lịch sử, watchlist, bộ sưu tập, thông báo)
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // Thông báo cá nhân: người dùng tự đọc/ghi thông báo của mình hoặc người khác phản hồi bình luận
      match /notifications/{notifId} {
        allow read, create, update, delete: if true;
      }

      // Các mục con bên trong users/{userId} (watch_history, watchlist, collections, followed_series, ...)
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // 2. Bộ sưu tập phim công khai: Bất kỳ ai có liên kết đều có thể đọc
    match /public_collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Bình luận, đánh giá và reply phim cộng đồng
    //    - Ai cũng xem được (kể cả khách)
    //    - Phải đăng nhập để tạo/like/xóa bình luận
    //    - Chỉ chủ bình luận hoặc admin mới xóa được
    match /movie_comments/{commentId} {
      allow read, create, update, delete: if true;
    }

    // 4. Nhật ký vi phạm kiểm duyệt
    match /admin_violations/{violId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
  }
}
